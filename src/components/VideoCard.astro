---
import type { Video } from '../lib/utils';
import { formatDate, youtubeId } from '../lib/utils';
import CarImage from './CarImage.astro';
interface Props { video: Video }
const { video } = Astro.props;
const { data } = video;
const id = data.type === 'youtube' ? youtubeId(data.youtubeUrl) : null;
const thumb = data.poster ?? (id ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg` : undefined);
const upcoming = data.type === 'upload' && !data.videoFile;
---
<article class="vcard">
  <a href={`/videos/${video.id}`} class="thumb" aria-label={`Watch: ${data.title}`}>
    <CarImage src={thumb} alt={data.title} label={data.title} />
    <span class="play" aria-hidden="true">▶</span>
    {data.duration && <span class="dur">{data.duration}</span>}
    {upcoming && <span class="tag">Coming soon</span>}
    {!upcoming && !thumb && <span class="tag">Video coming soon</span>}
  </a>
  <h3><a href={`/videos/${video.id}`}>{data.title}</a></h3>
  <p class="meta">{data.type === 'upload' ? 'Original video' : 'YouTube'} · {formatDate(data.pubDate)}</p>
</article>
<style>
  .thumb { position: relative; display: block; border-radius: var(--radius); overflow: hidden; }
  .play { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 58px; height: 58px; border-radius: 50%; background: rgba(155, 44, 44, .92); color: #fff; display: grid; place-items: center; font-size: 1.2rem; padding-left: 4px; box-shadow: 0 4px 14px rgba(0,0,0,.35); }
  .dur { position: absolute; right: .5rem; bottom: .5rem; background: rgba(0,0,0,.75); color: #fff; font-size: .75rem; padding: .15rem .45rem; border-radius: 4px; }
  .tag { position: absolute; left: .5rem; top: .5rem; background: var(--gold); color: #fff; font-size: .7rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: .25rem .5rem; border-radius: 4px; }
  h3 { font-size: 1.08rem; margin: .7rem 0 .2rem; }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a:hover { color: var(--accent); text-decoration: underline; }
  .meta { color: var(--muted); font-size: .8rem; margin: 0; }
</style>
