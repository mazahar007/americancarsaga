---
import type { Article } from '../lib/utils';
import { formatDate, readingTime } from '../lib/utils';
import { getCategory } from '../config';
import CarImage from './CarImage.astro';
import Stars from './Stars.astro';
interface Props { article: Article; size?: 'normal' | 'large' | 'compact'; eager?: boolean; headingLevel?: 'h2' | 'h3' }
const { article, size = 'normal', eager = false, headingLevel = 'h3' } = Astro.props;
const { data } = article;
const cat = getCategory(data.category);
const H = headingLevel;
---
<article class={`card card-${size}`}>
  <a href={`/articles/${article.id}`} class="card-media" tabindex="-1" aria-hidden="true">
    <CarImage src={data.heroImage} alt={data.heroAlt ?? data.title} label={data.title} eager={eager} />
  </a>
  <div class="card-body">
    <div class="card-meta-top">
      {cat && <a class="kicker" href={`/category/${cat.slug}`}>{cat.short}</a>}
      {data.sponsored && <span class="sponsored-tag">Sponsored</span>}
    </div>
    <H class="card-title"><a href={`/articles/${article.id}`}>{data.title}</a></H>
    {size !== 'compact' && <p class="card-desc">{data.description}</p>}
    <p class="card-meta">
      {typeof data.rating === 'number' && <Stars value={data.rating} />}
      <span>{formatDate(data.pubDate)}</span>
      {size !== 'compact' && <><span aria-hidden="true">·</span><span>{readingTime(article.body)} min read</span></>}
    </p>
  </div>
</article>
<style>
  .card { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); transition: transform .2s ease, box-shadow .2s ease; }
  .card:hover { transform: translateY(-2px); }
  .card-media :global(.car-img) { border-radius: 0; }
  .card-body { padding: 1rem 1.15rem 1.2rem; display: flex; flex-direction: column; gap: .35rem; flex: 1; }
  .card-meta-top { display: flex; gap: .6rem; align-items: center; }
  .card-title { margin: .1rem 0 .1rem; font-size: 1.18rem; line-height: 1.3; }
  .card-title a { color: var(--text); text-decoration: none; }
  .card-title a:hover { color: var(--accent); text-decoration: underline; }
  .card-desc { color: var(--muted); margin: 0; font-size: .93rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card-meta { margin: auto 0 0; padding-top: .5rem; color: var(--muted); font-size: .8rem; display: flex; gap: .45rem; flex-wrap: wrap; align-items: center; }
  .card-large .card-title { font-size: clamp(1.5rem, 3vw, 2.1rem); }
  .card-large .card-desc { font-size: 1rem; -webkit-line-clamp: 4; }
  .card-large .card-body { padding: 1.3rem 1.5rem 1.5rem; }
  .card-compact { flex-direction: row; align-items: flex-start; box-shadow: none; }
  .card-compact .card-media { flex: 0 0 36%; max-width: 150px; padding: .7rem 0 .7rem .7rem; }
  .card-compact .card-media :global(.car-img) { aspect-ratio: 4 / 3 !important; border-radius: 6px; }
  .card-compact .card-body { padding: .7rem .9rem; }
  .card-compact .card-title { font-size: 1rem; }
</style>
