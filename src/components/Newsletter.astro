---
import { SITE } from '../config';
---
<section class="nl">
  <div class="container nl-inner">
    <div>
      <h2>Get the Saga in your inbox</h2>
      <p>One friendly email a week: new stories, honest reviews and the best deals for classic car owners. No spam, unsubscribe anytime.</p>
    </div>
    {SITE.newsletterAction ? (
      <form action={SITE.newsletterAction} method="post" target="_blank" class="nl-form">
        <label for="nl-email" class="visually-hidden">Email address</label>
        <input id="nl-email" type="email" name="email" required placeholder="Your email address" autocomplete="email" />
        <button class="btn btn-accent" type="submit">Subscribe</button>
      </form>
    ) : (
      <div class="nl-form"><a class="btn btn-accent" href="/contact">Join our reader list</a></div>
    )}
  </div>
</section>
<style>
  .nl { background: var(--band); color: var(--on-band); padding: 2.6rem 0; }
  .nl-inner { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2rem; align-items: center; }
  h2 { color: var(--on-band); margin: 0 0 .4rem; }
  p { margin: 0; opacity: .92; }
  .nl-form { display: flex; gap: .6rem; flex-wrap: wrap; }
  .nl-form input { flex: 1 1 220px; border-color: transparent; }
  @media (max-width: 760px) { .nl-inner { grid-template-columns: 1fr; } }
</style>
