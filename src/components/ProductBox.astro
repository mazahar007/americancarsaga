---
import CarImage from './CarImage.astro';
interface Product { name: string; badge?: string; description?: string; image?: string; url: string; buttonText: string }
interface Props { products: Product[] }
const { products } = Astro.props;
---
{products.length > 0 && (
  <section class="products" aria-label="Our picks">
    <h2>Our Top Picks</h2>
    <p class="note">We may earn a commission when you buy through these links, at no extra cost to you. <a href="/affiliate-disclosure">Learn more</a>.</p>
    <ol>
      {products.map((p, i) => (
        <li class="product">
          <div class="p-img">
            {p.image ? <img src={p.image} alt={p.name} loading="lazy" decoding="async" width="300" height="300" /> : <CarImage alt={p.name} label={p.name} ratio="1 / 1" />}
          </div>
          <div class="p-body">
            {p.badge && <span class="badge">{p.badge}</span>}
            <h3><span class="rank">{i + 1}.</span> {p.name}</h3>
            {p.description && <p>{p.description}</p>}
            <a class="btn btn-accent" href={p.url} rel="sponsored nofollow noopener" target="_blank">{p.buttonText} →</a>
          </div>
        </li>
      ))}
    </ol>
  </section>
)}
<style>
  .products { margin: 2.5rem 0; }
  .products h2 { border: 0; padding: 0; margin: 0 0 .3rem; }
  .note { font-size: .85rem; color: var(--muted); }
  ol { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .product { display: grid; grid-template-columns: 160px 1fr; gap: 1.2rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; box-shadow: var(--shadow); }
  .p-img img { border-radius: 8px; aspect-ratio: 1; object-fit: cover; }
  .badge { display: inline-block; background: var(--primary); color: var(--on-primary); font-size: .72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: .3em .6em; border-radius: 4px; }
  h3 { margin: .4rem 0 .3rem; font-size: 1.2rem; }
  .rank { color: var(--gold); }
  .p-body p { margin: 0 0 .8rem; color: var(--muted); font-size: .95rem; }
  @media (max-width: 560px) { .product { grid-template-columns: 1fr; } .p-img { max-width: 220px; } }
</style>
