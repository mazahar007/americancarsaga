---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE } from '../config';
---
<PageLayout title="Contact Us" description={`Contact ${SITE.name}`} intro="Questions, corrections, story ideas or partnership requests — we read every message.">
  <p>Email us directly at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>, or use the form below.</p>
  <p id="form-error" class="form-error" hidden>Sorry, your message could not be sent. Please check the fields or email us directly.</p>
  <form name="contact" method="POST" action="/api/contact.php" class="contact-form">
    <p class="visually-hidden"><label>Leave empty <input name="company" /></label></p>
    <div><label for="name">Your name</label><input id="name" name="name" required autocomplete="name" /></div>
    <div><label for="email">Your email</label><input id="email" type="email" name="email" required autocomplete="email" /></div>
    <div>
      <label for="topic">Topic</label>
      <select id="topic" name="topic">
        <option>General question</option><option>Story idea</option><option>Correction</option><option>Advertising / Brand partnership</option><option>Newsletter sign-up</option>
      </select>
    </div>
    <div><label for="msg">Message</label><textarea id="msg" name="message" rows="6" required></textarea></div>
    <button class="btn btn-primary" type="submit">Send message</button>
  </form>
</PageLayout>
<script is:inline>
  if (/[?&]error=1/.test(location.search)) document.getElementById('form-error').hidden = false;
</script>
<style>
  .form-error { background: var(--surface-2); border-left: 4px solid var(--accent); padding: .7rem 1rem; border-radius: 6px; }
  .contact-form { display: grid; gap: 1.1rem; max-width: 36rem; margin-top: 1.5rem; }
</style>
