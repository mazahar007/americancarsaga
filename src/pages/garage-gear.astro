---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PodSymbols from '../components/PodSymbols.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE } from '../config';
import { POD_DESIGNS, POD_PRODUCTS, POD_COLORS } from '../data/pod';

const first = POD_DESIGNS[0];
// Accent per design: deeper tones for the light site, brighter ones for Night mode
const accentsLight = ['#1d4e89', '#a32d52', '#a35a00', '#0f7a62', '#6a3fb3', '#8a6d00'];
const accentsDark = ['#9dbbe3', '#f08aa8', '#f0b46b', '#7fd0b5', '#c2a6f0', '#e6cf6b'];
const cfg = {
  storeUrl: SITE.pod.storeUrl,
  email: SITE.email,
  designs: Object.fromEntries(POD_DESIGNS.map((d) => [d.id, { name: d.name, url: d.url ?? '' }])),
  products: Object.fromEntries(POD_PRODUCTS.map((p) => [p.id, p.name])),
  colors: Object.fromEntries(POD_COLORS.map((c) => [c.id, { name: c.name, hex: c.hex }])),
};
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Garage Gear', description: 'Original American car designs on tees, hoodies, mugs and posters.', url: `${SITE.url}/garage-gear` };
---
<BaseLayout title="Garage Gear — Car Culture Apparel & Gifts" description="Original American car designs on tees, hoodies, mugs and posters. Preview every design on every product, add your own line, then order." jsonLd={jsonLd} contentGroup="Garage Gear" pageType="shop">
  <PodSymbols />
  <script is:inline>document.documentElement.classList.add('js');</script>

  <section class="gg-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Garage Gear' }]} />
      <div class="hero-grid">
        <div>
          <p class="kicker">Print on demand · Made for car people</p>
          <h1>Garage Gear</h1>
          <p class="lead">Original American car art for people who still check the oil. Try every design on every product, add your own name or year, and order. Each piece is printed only after you order.</p>
          <div class="cta">
            <a class="btn btn-primary" href="#studio">Design yours →</a>
            <a class="btn btn-ghost" href="#collection">See the collection</a>
          </div>
          <ul class="facts">
            <li><strong>{POD_DESIGNS.length}</strong> original designs</li>
            <li><strong>{POD_PRODUCTS.length}</strong> products</li>
            <li><strong>{POD_COLORS.length}</strong> colours</li>
          </ul>
        </div>
        <figure class="hero-card">
          <svg viewBox="0 0 400 400" role="img" aria-label="Navy hoodie with the V8 Tachometer design">
            <defs><linearGradient id="hfold" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".16" /><stop offset="1" stop-color="#000" stop-opacity=".22" /></linearGradient></defs>
            <ellipse cx="200" cy="372" rx="130" ry="9" fill="#000" opacity=".1" />
            <path d="M135 72 L90 88 L35 205 L72 220 L105 168 L105 352 L295 352 L295 168 L328 220 L365 205 L310 88 L265 72 Q200 36 135 72 Z" fill="#1d3557" stroke="#000" stroke-opacity=".2" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M150 74 Q200 8 250 74 Q200 118 150 74 Z" fill="#000" opacity=".22" />
            <path d="M180 100 V150 M220 100 V150" stroke="#f4efe3" stroke-opacity=".7" stroke-width="3" stroke-linecap="round" />
            <path d="M150 290 L250 290 L272 336 L128 336 Z" fill="#000" opacity=".14" />
            <path d="M135 72 L90 88 L35 205 L72 220 L105 168 L105 352 L295 352 L295 168 L328 220 L365 205 L310 88 L265 72 Q200 36 135 72 Z" fill="url(#hfold)" />
            <g style="--ink:#f4efe3;--ink2:#e3b866"><use href="#d-gauge" x="144" y="152" width="112" height="112" /></g>
          </svg>
          <figcaption>Shown: V8 Tachometer on a Navy hoodie</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section" id="studio" aria-labelledby="studio-h">
    <div class="container">
      <div class="section-head"><h2 id="studio-h">Design yours</h2><span class="head-note">The preview updates as you choose</span></div>
      <div class="studio-grid">
        <div class="stage" id="stage" data-product="tee" style={`--g:${POD_COLORS[0].hex};--ink:#1d1d20;--ink2:#9b2c2c`}>
            <svg id="mock" viewBox="0 0 400 400" role="img" aria-label="Product preview">
              <defs>
                <linearGradient id="cyl" x1="0" x2="1"><stop offset="0" stop-color="#000" stop-opacity=".3" /><stop offset=".3" stop-color="#fff" stop-opacity=".2" /><stop offset=".55" stop-color="#000" stop-opacity="0" /><stop offset="1" stop-color="#000" stop-opacity=".34" /></linearGradient>
                <linearGradient id="fold" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".16" /><stop offset="1" stop-color="#000" stop-opacity=".22" /></linearGradient>
              </defs>
              <ellipse cx="200" cy="372" rx="130" ry="9" fill="#000" opacity=".1" />

              <g data-p="tee">
                <path d="M140 60 L100 75 L40 125 L75 165 L105 145 L105 340 L295 340 L295 145 L325 165 L360 125 L300 75 L260 60 Q200 102 140 60 Z" fill="var(--g)" stroke="var(--rim)" stroke-opacity=".5" stroke-width="1.5" stroke-linejoin="round" />
                <path d="M140 60 Q200 102 260 60 Q200 82 140 60 Z" fill="#000" opacity=".25" />
                <path d="M140 60 L100 75 L40 125 L75 165 L105 145 L105 340 L295 340 L295 145 L325 165 L360 125 L300 75 L260 60 Q200 102 140 60 Z" fill="url(#fold)" />
                <use class="art" href={`#d-${first.id}`} x="138" y="112" width="124" height="124" />
                <text class="custom" x="200" y="252" text-anchor="middle" font-family="Georgia, serif" font-weight="700" font-size="10" letter-spacing="1.5" fill="var(--ink)"></text>
              </g>

              <g data-p="hoodie" style="display:none">
                <path d="M135 72 L90 88 L35 205 L72 220 L105 168 L105 352 L295 352 L295 168 L328 220 L365 205 L310 88 L265 72 Q200 36 135 72 Z" fill="var(--g)" stroke="var(--rim)" stroke-opacity=".5" stroke-width="1.5" stroke-linejoin="round" />
                <path d="M150 74 Q200 8 250 74 Q200 118 150 74 Z" fill="#000" opacity=".22" />
                <path d="M180 100 V150 M220 100 V150" stroke="var(--ink)" stroke-opacity=".6" stroke-width="3" stroke-linecap="round" />
                <path d="M150 290 L250 290 L272 336 L128 336 Z" fill="#000" opacity=".14" />
                <path d="M135 72 L90 88 L35 205 L72 220 L105 168 L105 352 L295 352 L295 168 L328 220 L365 205 L310 88 L265 72 Q200 36 135 72 Z" fill="url(#fold)" />
                <use class="art" href={`#d-${first.id}`} x="144" y="152" width="112" height="112" />
                <text class="custom" x="200" y="278" text-anchor="middle" font-family="Georgia, serif" font-weight="700" font-size="9" letter-spacing="1.5" fill="var(--ink)"></text>
              </g>

              <g data-p="mug" style="display:none">
                <path d="M280 150 Q352 150 352 206 Q352 262 280 262" fill="none" stroke="var(--g)" stroke-width="20" />
                <path d="M280 150 Q352 150 352 206 Q352 262 280 262" fill="none" stroke="var(--rim)" stroke-opacity=".5" stroke-width="1.5" />
                <rect x="108" y="104" width="176" height="200" rx="14" fill="var(--g)" stroke="var(--rim)" stroke-opacity=".5" stroke-width="1.5" />
                <rect x="108" y="104" width="176" height="200" rx="14" fill="url(#cyl)" />
                <ellipse cx="196" cy="104" rx="88" ry="12" fill="#000" opacity=".3" />
                <ellipse cx="196" cy="104" rx="88" ry="12" fill="none" stroke="var(--rim)" stroke-opacity=".4" />
                <use class="art" href={`#d-${first.id}`} x="136" y="140" width="120" height="120" />
                <text class="custom" x="196" y="278" text-anchor="middle" font-family="Georgia, serif" font-weight="700" font-size="9" letter-spacing="1.5" fill="var(--ink)"></text>
              </g>

              <g data-p="poster" style="display:none">
                <rect x="84" y="34" width="232" height="326" fill="#2b2924" stroke="var(--rim)" stroke-opacity=".5" stroke-width="1.5" />
                <rect x="100" y="50" width="200" height="294" fill="var(--g)" />
                <rect x="100" y="50" width="200" height="294" fill="url(#fold)" opacity=".5" />
                <use class="art" href={`#d-${first.id}`} x="112" y="92" width="176" height="176" />
                <text class="custom" x="200" y="302" text-anchor="middle" font-family="Georgia, serif" font-weight="700" font-size="12" letter-spacing="2" fill="var(--ink)"></text>
                <text x="200" y="326" text-anchor="middle" font-family="Georgia, serif" font-size="7" letter-spacing="3" fill="var(--ink)" opacity=".7">AMERICAN CAR SAGA</text>
              </g>
            </svg>
          <p class="stage-caption" id="caption" aria-live="polite">{first.name} · T-Shirt · {POD_COLORS[0].name}</p>
        </div>

        <form class="controls" onsubmit="return false" aria-label="Customize your product">
          <fieldset>
            <legend><span class="n">1</span> Pick a design</legend>
            <div class="designs">
              {POD_DESIGNS.map((d, i) => (
                <label class="design" style={`--a-l:${accentsLight[i % 6]};--a-d:${accentsDark[i % 6]}`}>
                  <input type="radio" name="design" value={d.id} checked={i === 0} />
                  <span class="thumb"><svg viewBox="0 0 200 200" aria-hidden="true"><use href={`#d-${d.id}`} width="200" height="200" /></svg></span>
                  <span class="d-name">{d.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset>
            <legend><span class="n">2</span> Choose a product</legend>
            <div class="pills">
              {POD_PRODUCTS.map((p, i) => (
                <label class="pill"><input type="radio" name="product" value={p.id} checked={i === 0} /><span><strong>{p.name}</strong><small>{p.note}</small></span></label>
              ))}
            </div>
          </fieldset>

          <fieldset>
            <legend><span class="n">3</span> Pick a colour</legend>
            <div class="swatches">
              {POD_COLORS.map((c, i) => (
                <label class="swatch" title={c.name}><input type="radio" name="color" value={c.id} checked={i === 0} /><span style={`background:${c.hex}`}></span><em>{c.name}</em></label>
              ))}
            </div>
          </fieldset>

          <div class="personal">
            <label for="custom"><span class="n">4</span> Add your own line <small>(optional)</small></label>
            <input id="custom" name="custom" type="text" maxlength="26" placeholder="e.g. Dave’s 1969 Camaro" autocomplete="off" />
            <p class="hint">A name, a year or your car. It appears under the design. Personalised items need the personalisation option enabled in the store.</p>
          </div>

          <div class="buy">
            <a id="buy" class="btn btn-accent" href="#" rel="noopener" target="_blank" data-pod="buy">Order this design <span aria-hidden="true">→</span></a>
            <p class="ship">{SITE.pod.shippingNote}</p>
            {!SITE.pod.storeUrl && <p class="ship soon">Our store opens soon. The button sends us a message so we can let you know.</p>}
          </div>
        </form>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="collection" aria-labelledby="coll-h">
    <div class="container">
      <div class="section-head"><h2 id="coll-h">The Collection</h2><span class="head-note">{POD_DESIGNS.length} original designs</span></div>
      <div class="grid grid-3">
        {POD_DESIGNS.map((d, i) => (
          <article class="coll-card rv" style={`--a-l:${accentsLight[i % 6]};--a-d:${accentsDark[i % 6]};--d:${(i % 3) * 0.08}s`}>
            <div class="coll-art"><svg viewBox="0 0 200 200" aria-hidden="true"><use href={`#d-${d.id}`} width="200" height="200" /></svg></div>
            <div class="coll-body">
              <h3>{d.name}</h3>
              <p>{d.tagline}</p>
              <button type="button" class="btn btn-ghost try" data-design={d.id}>Try it on a product ↑</button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="container"><AdSlot slot="inArticle" /></div>

  <section class="section" id="anatomy" aria-labelledby="anat-h">
    <div class="container anat-grid">
      <div>
        <h2 id="anat-h">What goes into every piece</h2>
        <p class="sub">Scroll down and the four parts separate.</p>
        <ol class="alist" id="alist">
          <li data-k="3"><span class="n">1</span><div><strong>The artwork</strong><span>Drawn for American Car Saga as vector art, so it prints sharp at any size.</span></div></li>
          <li data-k="2"><span class="n">2</span><div><strong>The print</strong><span>Printed on demand, only after you order.</span></div></li>
          <li data-k="1"><span class="n">3</span><div><strong>Your line</strong><span>An optional name, year or car under the artwork.</span></div></li>
          <li data-k="0"><span class="n">4</span><div><strong>The product</strong><span>The shirt, hoodie, mug or poster, made by our print partner.</span></div></li>
        </ol>
      </div>
      <div class="exp" id="exp" aria-hidden="true">
        <div class="stack">
          <div class="layer l0"><span class="weave"></span><em>Product</em></div>
          <div class="layer l1"><span class="yourline">Your line here</span><em>Your line</em></div>
          <div class="layer l2"><span class="dots"></span><em>Print</em></div>
          <div class="layer l3"><svg viewBox="0 0 200 200"><use href="#d-route66" width="200" height="200" /></svg><em>Artwork</em></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="how-h">
    <div class="container">
      <div class="section-head"><h2 id="how-h">How it works</h2></div>
      <ol class="steps">
        <li class="rv"><span class="n big">1</span><h3>Design it</h3><p>Pick a design, a product and a colour. Add your own line if you like.</p></li>
        <li class="rv" style="--d:.08s"><span class="n big">2</span><h3>We print it</h3><p>Your item is printed only after you order, by our print-on-demand partner.</p></li>
        <li class="rv" style="--d:.16s"><span class="n big">3</span><h3>It ships to you</h3><p>Delivered straight to your door, with tracking sent by email.</p></li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-h">
    <div class="container narrow">
      <div class="section-head"><h2 id="faq-h">Questions</h2></div>
      <details><summary>Where do I pay?</summary><p>Checkout happens securely on our store partner’s site, not on American Car Saga, so we never see your card details.</p></details>
      <details><summary>How long does delivery take?</summary><p>Items are made to order, so production plus shipping usually takes about one to two weeks. The exact estimate is shown at checkout.</p></details>
      <details><summary>Can I return an item?</summary><p>If an item arrives damaged or misprinted we will replace it. Because everything is made just for you, other returns are limited. Full details are on the store’s policy page.</p></details>
      <details><summary>Does the preview match the real product?</summary><p>The preview is an illustration. Real fabric, ink and colours can look slightly different on screen and in person.</p></details>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ cfg }}>
  (function () {
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Gentle fade-in as sections scroll into view
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.12 });
    document.querySelectorAll('.rv').forEach(function (el) { io.observe(el); });

    // Anatomy: the layers separate as the section scrolls into view
    var exp = document.getElementById('exp'), items = document.querySelectorAll('#alist li'), busy = 0;
    function spread() {
      busy = 0;
      var r = exp.getBoundingClientRect(), vh = innerHeight;
      var p = reduce ? 1 : Math.max(0, Math.min(1, (vh * 0.9 - r.top) / (vh * 0.55)));
      exp.style.setProperty('--sp', p.toFixed(3));
      items.forEach(function (li) { li.classList.toggle('on', p > 0.12 + (3 - +li.dataset.k) * 0.22); });
    }
    if (exp) { spread(); addEventListener('scroll', function () { if (!busy) busy = requestAnimationFrame(spread); }, { passive: true }); addEventListener('resize', spread); }

    // Studio
    var stage = document.getElementById('stage'), mock = document.getElementById('mock');
    var cap = document.getElementById('caption'), buy = document.getElementById('buy');
    var form = document.querySelector('.controls');
    var state = { design: form.design.value, product: form.product.value, color: form.color.value, text: '' };
    function lum(hex) { var n = parseInt(hex.slice(1), 16); return (0.299 * (n >> 16) + 0.587 * ((n >> 8) & 255) + 0.114 * (n & 255)) / 255; }
    function render() {
      var c = cfg.colors[state.color], light = lum(c.hex) > 0.55;
      stage.style.setProperty('--g', c.hex);
      stage.style.setProperty('--ink', light ? '#1d1d20' : '#f4efe3');
      stage.style.setProperty('--ink2', light ? '#9b2c2c' : '#e3b866');
      mock.querySelectorAll('[data-p]').forEach(function (g) { g.style.display = g.dataset.p === state.product ? '' : 'none'; });
      mock.querySelectorAll('.art').forEach(function (u) { u.setAttribute('href', '#d-' + state.design); });
      mock.querySelectorAll('.custom').forEach(function (t) { t.textContent = state.text.toUpperCase(); });
      var d = cfg.designs[state.design];
      cap.textContent = d.name + ' · ' + cfg.products[state.product] + ' · ' + c.name + (state.text ? ' · “' + state.text + '”' : '');
      var base = d.url || cfg.storeUrl;
      if (base) {
        var u = new URL(base, location.href);
        u.searchParams.set('utm_source', 'americancarsaga'); u.searchParams.set('utm_medium', 'garage_gear'); u.searchParams.set('utm_campaign', state.design);
        if (state.text) u.searchParams.set('custom_text', state.text);
        buy.href = u.toString(); buy.target = '_blank'; buy.firstChild.nodeValue = 'Order this design ';
      } else {
        var body = 'Please let me know when Garage Gear opens.\n\nDesign: ' + d.name + '\nProduct: ' + cfg.products[state.product] + '\nColour: ' + c.name + (state.text ? '\nMy line: ' + state.text : '');
        buy.href = 'mailto:' + cfg.email + '?subject=' + encodeURIComponent('Garage Gear: let me know') + '&body=' + encodeURIComponent(body);
        buy.removeAttribute('target'); buy.firstChild.nodeValue = 'Let me know when it opens ';
      }
      buy.dataset.product = d.name + ' / ' + cfg.products[state.product];
    }
    form.addEventListener('change', function (e) {
      if (e.target.name in state) { state[e.target.name] = e.target.value; render();
        window.acsTrack && acsTrack('pod_select', { option: e.target.name, value: e.target.value }); }
    });
    form.custom.addEventListener('input', function () { state.text = form.custom.value.trim(); render(); });
    document.querySelectorAll('.try').forEach(function (b) {
      b.addEventListener('click', function () {
        form.design.value = b.dataset.design; state.design = b.dataset.design; render();
        document.getElementById('studio').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        window.acsTrack && acsTrack('pod_select', { option: 'design', value: b.dataset.design, from: 'collection' });
      });
    });
    render();
  })();
</script>

<style>
  /* Per-design accent colours, switched by the site's Night mode */
  .design, .coll-card { --acc: var(--a-l); }
  :global(:root[data-theme='dark']) .design, :global(:root[data-theme='dark']) .coll-card { --acc: var(--a-d); }
  .thumb, .coll-art, .l3 { --ink: var(--text); --ink2: var(--acc, var(--accent)); }
  .stage, .hero-card { --rim: rgba(30, 34, 39, .3); }
  :global(:root[data-theme='dark']) .stage { --rim: rgba(236, 230, 218, .35); }

  /* fade-in */
  :global(.js) .rv { opacity: 0; transform: translateY(16px); transition: opacity .7s ease, transform .7s ease; transition-delay: var(--d, 0s); }
  :global(.js) .rv.in { opacity: 1; transform: none; }

  .n { display: inline-grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 50%; background: var(--primary); color: var(--on-primary); font: 700 .85rem/1 var(--font-body); flex: none; }
  .n.big { width: 2.4rem; height: 2.4rem; font-size: 1rem; }
  .head-note { color: var(--muted); font-size: .9rem; }
  .narrow { max-width: 52rem; }

  /* hero */
  .gg-hero { background: linear-gradient(180deg, var(--surface-2), var(--bg)); border-bottom: 1px solid var(--border); padding-bottom: 2.4rem; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
  .gg-hero h1 { margin: .2rem 0 .5rem; }
  .lead { font-family: var(--font-head); font-size: 1.15rem; color: var(--muted); max-width: 36rem; }
  .cta { display: flex; flex-wrap: wrap; gap: .8rem; margin: 1.4rem 0 1.4rem; }
  .facts { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .4rem 1.6rem; color: var(--muted); font-size: .95rem; }
  .facts strong { color: var(--text); font-family: var(--font-head); font-size: 1.25rem; margin-right: .2rem; }
  .hero-card { margin: 0; background: radial-gradient(circle at 50% 42%, var(--surface), var(--surface-2)); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); padding: 1rem 1rem .8rem; }
  .hero-card svg { width: 100%; height: auto; max-height: 420px; }
  .hero-card figcaption { text-align: center; color: var(--muted); font-size: .85rem; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } .hero-card svg { max-height: 300px; } }

  /* studio */
  .studio-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(1.2rem, 3vw, 2.6rem); align-items: start; }
  .stage { position: sticky; top: 1rem; background: radial-gradient(circle at 50% 38%, var(--surface), var(--surface-2)); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; box-shadow: var(--shadow); }
  .stage svg { width: 100%; height: auto; }
  .stage-caption { text-align: center; margin: .4rem 0 0; color: var(--muted); font-size: .9rem; }
  .controls { display: grid; gap: 1.6rem; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  legend, .personal > label { display: flex; align-items: center; gap: .6rem; font: 700 1.1rem var(--font-head); margin-bottom: .7rem; padding: 0; }
  .personal small { font: 400 .85rem var(--font-body); color: var(--muted); }
  input[type='radio'] { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .designs { display: grid; grid-template-columns: repeat(auto-fill, minmax(7.8rem, 1fr)); gap: .7rem; }
  .design { display: flex; flex-direction: column; gap: .35rem; cursor: pointer; text-align: center; font-size: .85rem; font-weight: 600; }
  .thumb { display: block; background: var(--surface-2); border: 2px solid var(--border); border-radius: 10px; padding: .35rem; transition: border-color .2s, transform .2s; }
  .thumb svg { width: 100%; height: auto; }
