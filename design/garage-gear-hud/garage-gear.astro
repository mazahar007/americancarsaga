  /* reveal */
  :global(.js) .rv { opacity: 0; transform: translateY(26px); transition: opacity .8s ease, transform .8s cubic-bezier(.2, .7, .2, 1); transition-delay: var(--d, 0s); }
  :global(.js) .rv.in { opacity: 1; transform: none; }

  /* corner brackets */
  .c { position: absolute; width: 14px; height: 14px; border: 0 solid var(--line2); pointer-events: none; transition: border-color .3s, width .3s, height .3s; }
  .c.tl { top: -1px; left: -1px; border-top-width: 1.5px; border-left-width: 1.5px; }
  .c.tr { top: -1px; right: -1px; border-top-width: 1.5px; border-right-width: 1.5px; }
  .c.bl { bottom: -1px; left: -1px; border-bottom-width: 1.5px; border-left-width: 1.5px; }
  .c.br { bottom: -1px; right: -1px; border-bottom-width: 1.5px; border-right-width: 1.5px; }

  /* buttons */
  .obtn { display: inline-flex; align-items: center; justify-content: center; gap: .6em; min-height: 48px; padding: 0 1.3em; font: 500 .8rem/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; text-decoration: none; color: var(--head); background: transparent; border: 1px solid var(--line2); cursor: pointer; transition: background .2s, color .2s, border-color .2s, transform .2s; }
  .obtn span { transition: transform .2s; }
  .obtn:hover { border-color: var(--head); background: var(--hover); }
  .obtn:hover span { transform: translateX(4px); }
  .obtn.solid { background: var(--solid-bg); color: var(--solid-fg); border-color: var(--solid-bg); }
  .obtn.solid:hover { background: var(--acc); border-color: var(--acc); color: var(--bg); }
  .obtn.small { min-height: 38px; padding: 0 .9em; font-size: .72rem; }
  .obtn.big { width: 100%; min-height: 58px; font-size: .88rem; }
  .hud :focus-visible { outline: 2px solid var(--acc); outline-offset: 3px; }

  /* nav */
  .hnav { position: sticky; top: 0; z-index: 50 !important; background: var(--bg-a); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .hnav-in { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 60px; }
  .brand { display: inline-flex; align-items: center; gap: .6rem; text-decoration: none; font: 500 .8rem/1 var(--mono); letter-spacing: .14em; color: var(--head); }
  .b-arrow { color: var(--acc); }
  .b-name i { font-style: normal; color: var(--hot); margin: 0 .3em; }
  .hlinks { display: flex; gap: 1.6rem; }
  .hlinks a { font: 500 .8rem/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; text-decoration: none; color: var(--mut); padding: .6rem 0; transition: color .2s; }
  .hlinks a:hover { color: var(--head); }
  .hnav-r { display: flex; align-items: center; gap: .4rem; }
  
  @media (max-width: 760px) { .hlinks { display: none; } .b-name { font-size: .72rem; } }

  /* display settings toolbar */
  .toolbar-wrap { border-bottom: 1px solid var(--line); background: var(--panel-b); }
  .toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: .3rem 1.6rem; padding-top: .5rem; padding-bottom: .5rem; }
  .grp { display: flex; align-items: center; gap: .4rem; }
  .tl { font: 500 .74rem var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--mut); min-width: 4.6rem; }
  .seg { min-width: 44px; min-height: 40px; padding: 0 .85rem; background: transparent; border: 1px solid var(--line); color: var(--txt); font: 500 .82rem var(--mono); letter-spacing: .06em; cursor: pointer; transition: background .2s, color .2s, border-color .2s; }
  .seg:hover { border-color: var(--line2); background: var(--hover); }
  .seg[aria-pressed='true'] { background: var(--solid-bg); color: var(--solid-fg); border-color: var(--solid-bg); }
  @media (max-width: 640px) { .toolbar { gap: .25rem 0; } .grp { width: 100%; } .seg { min-height: 38px; } }

  /* hero */
  .hero { padding: clamp(2rem, 6vw, 4.5rem) 0 clamp(2.5rem, 6vw, 4rem); position: relative; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: center; }
  .cta { display: flex; flex-wrap: wrap; gap: .8rem; margin-bottom: 2rem; }
  .stats { display: flex; gap: clamp(1.2rem, 4vw, 3rem); margin: 0; padding-top: 1.2rem; border-top: 1px solid var(--line); }
  .stats dt { font: 500 .78rem/1 var(--mono); letter-spacing: .16em; text-transform: uppercase; color: var(--mut); }
  .stats dd { margin: .5rem 0 0; font: 500 2.2rem/1 var(--mono); color: var(--head); }
  .plate { position: relative; margin: 0; aspect-ratio: 1 / 1; max-width: 560px; justify-self: center; width: 100%; border: 1px solid var(--line); background: radial-gradient(circle at 50% 45%, var(--plate-bg), transparent 62%), var(--panel-a);
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transition: transform .25s ease-out; }
