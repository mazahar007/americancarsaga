    --layer: rgba(255, 253, 248, .88); --layer3: rgba(255, 253, 248, .72);
    --layer0: linear-gradient(135deg, rgba(29, 78, 137, .18), rgba(255, 253, 248, .92));
    --weave: rgba(29, 53, 87, .3); --art-ink: #14243d;
    --plate-bg: rgba(29, 78, 137, .1); --plate-shadow: rgba(29, 53, 87, .3); --ring-op: .28;
    --rim: #1d3557; --glitch: 1px 0 rgba(155, 44, 44, .35), -1px 0 rgba(29, 78, 137, .35);
    --mono: ui-monospace, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;
    position: relative; background: var(--bg); color: var(--txt); min-height: 100vh; overflow-x: clip; line-height: 1.6;
  }
  .hud[data-theme='dark'] {
    --bg: #06070a; --line: rgba(170, 190, 255, .16); --line2: rgba(170, 190, 255, .38);
    --txt: #e8ecf7; --mut: #9ba5bd; --acc: #8fb0ff; --hot: #ff6fa8;
    --head: #fff; --lead: #c3cbe0; --faint: #7a84a0;
    --tint: rgba(255, 255, 255, .03); --hover: rgba(255, 255, 255, .08);
    --panel-a: rgba(8, 10, 16, .6); --panel-b: rgba(8, 10, 16, .7);
    --bg-a: rgba(6, 7, 10, .72); --bg-b: rgba(6, 7, 10, .85);
    --solid-bg: #f2f5ff; --solid-fg: #06070a;
    --grid: rgba(150, 170, 255, .06);
    --stage1: #151a2c; --stage2: #08090d;
    --layer: rgba(14, 18, 30, .78); --layer3: rgba(14, 18, 30, .5);
    --layer0: linear-gradient(135deg, rgba(60, 80, 200, .35), rgba(14, 18, 30, .9));
    --weave: rgba(170, 190, 255, .22); --art-ink: #e6edff;
    --plate-bg: rgba(80, 100, 220, .16); --plate-shadow: rgba(90, 80, 255, .35); --ring-op: .42;
    --rim: #a9c0ff; --glitch: 2px 0 rgba(255, 80, 150, .7), -2px 0 rgba(70, 200, 255, .7);
  }
  /* per-design accent: deeper tones on light, neon on dark */
  .design, .card { --acc: var(--a-l); }
  .hud[data-theme='dark'] .design, .hud[data-theme='dark'] .card { --acc: var(--a-d); }
  .thumb, .card-art { --ink: var(--art-ink); --ink2: var(--acc); }
  .l3 { --ink: var(--art-ink); --ink2: var(--acc); }
  .hud :global(a) { color: inherit; }
  #lattice { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 0; pointer-events: none;
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 22px 22px; }
  .hud > :not(canvas):not(script):not(noscript):not(svg) { position: relative; z-index: 1; }
  .wrap { width: 100%; max-width: 1280px; margin: 0 auto; padding: 0 clamp(16px, 3.4vw, 44px); }
  .narrow { max-width: 54rem; }

  /* type */
  .hud h1, .hud h2, .hud h3 { font-family: var(--mono); text-transform: uppercase; color: var(--head); font-weight: 500; letter-spacing: .01em; text-wrap: balance; }
  .hud h1 { font-size: clamp(2.5rem, 9.6vw, 6.2rem); line-height: .98; margin: .25em 0 .35em; }
  .hud h2 { font-size: clamp(1.8rem, 5.6vw, 3.6rem); line-height: 1.02; margin: .15em 0 .3em; }
