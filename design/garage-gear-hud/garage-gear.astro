  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes drip { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } .plate { max-width: 420px; } }

  /* ticker */
  .ticker { border-block: 1px solid var(--line); background: var(--panel-b); overflow: hidden; }
  .ticker-track { display: flex; width: max-content; animation: marquee 38s linear infinite; }
  .ticker-set { display: flex; }
  .ticker-set span { padding: .9rem 1.6rem; font: 500 .8rem/1 var(--mono); letter-spacing: .2em; color: var(--mut); white-space: nowrap; }
  .ticker-set b { color: var(--hot); margin-left: 1.6rem; font-size: .6rem; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  /* sections */
  .sec { padding: clamp(3rem, 8vw, 6rem) 0; }
  .sec-head { margin-bottom: clamp(1.6rem, 4vw, 2.6rem); }
  .sec-head.row { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }

  /* studio */
  .studio-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(1.2rem, 3.4vw, 3rem); align-items: start; }
  .stage { position: sticky; top: 76px; border: 1px solid var(--line); background: radial-gradient(circle at 50% 40%, var(--stage1), var(--stage2) 78%); padding: 1.2rem 1rem .9rem; }
  .stage svg { width: 100%; height: auto; }
  .stage.pulse svg { animation: pulse .45s ease-out; }
  @keyframes pulse { 0% { opacity: .35; transform: scale(.97); filter: blur(2px); } 100% { opacity: 1; transform: none; filter: none; } }
  .tag { position: absolute; top: .7rem; font: 500 .72rem var(--mono); letter-spacing: .16em; color: var(--mut); }
  .tl-t { left: 1rem; } .tr-t { right: 1rem; }
  .stage-caption { text-align: center; margin: .3rem 0 0; color: var(--mut); font: 500 .8rem var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  .controls { display: grid; gap: 1.7rem; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  legend, .personal > label { font: 500 .8rem/1 var(--mono); letter-spacing: .16em; text-transform: uppercase; color: var(--head); margin-bottom: .8rem; padding: 0; display: block; }
  legend b, .personal b { color: var(--acc); margin-right: .6em; font-weight: 500; }
  .personal small { color: var(--mut); text-transform: none; letter-spacing: 0; font-family: inherit; }
  input[type='radio'] { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .designs { display: grid; grid-template-columns: repeat(auto-fill, minmax(7.6rem, 1fr)); gap: .6rem; }
