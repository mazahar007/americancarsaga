  .rpm b { color: var(--hot); font-weight: 500; }
  .scroll-cue { display: flex; flex-direction: column; align-items: center; gap: .5rem; width: max-content; margin: 2.2rem auto 0; font: 500 .74rem var(--mono); letter-spacing: .3em; color: var(--mut); text-decoration: none; }
  .scroll-cue i { display: block; width: 1px; height: 38px; background: linear-gradient(var(--acc), transparent); animation: drip 1.8s ease-in-out infinite; transform-origin: top; }
