---
import BaseLayout from '../layouts/BaseLayout.astro';
import PodSymbols from '../components/PodSymbols.astro';
import { SITE } from '../config';
import { POD_DESIGNS, POD_PRODUCTS, POD_COLORS } from '../data/pod';

const first = POD_DESIGNS[0];
const accents = ['#7ea4ff', '#ff6fa8', '#ffb66b', '#6bffd5', '#b78bff', '#ffe36b'];
const accentsLight = ['#1d4e89', '#a32d52', '#a35a00', '#0f7a62', '#6a3fb3', '#8a6d00'];
const cfg = {
  storeUrl: SITE.pod.storeUrl,
  email: SITE.email,
  designs: Object.fromEntries(POD_DESIGNS.map((d) => [d.id, { name: d.name, url: d.url ?? '' }])),
  products: Object.fromEntries(POD_PRODUCTS.map((p) => [p.id, p.name])),
  colors: Object.fromEntries(POD_COLORS.map((c) => [c.id, { name: c.name, hex: c.hex }])),
};
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Garage Gear', description: 'Original American car designs on tees, hoodies, mugs and posters.', url: `${SITE.url}/garage-gear` };
const ticker = ['SERIES 01', 'PRINTED ON DEMAND', 'ORIGINAL AMERICAN CAR ART', 'ADD YOUR OWN LINE', 'MADE ONLY WHEN YOU ORDER', 'NO WAREHOUSE. NO WASTE.'];
---
<BaseLayout title="Garage Gear — Car Culture Apparel & Gifts" description="Original American car designs on tees, hoodies, mugs and posters. Preview every design on every product, add your own line, then order." jsonLd={jsonLd} contentGroup="Garage Gear" pageType="shop" bare themeColor="#faf7f0">
  <div class="hud" id="top">
    <script is:inline>
      (function () {
        var h = document.getElementById('top'), t = null, m = null;
        try { t = localStorage.getItem('acs-pod-theme'); m = localStorage.getItem('acs-pod-motion'); if (!t && localStorage.getItem('acs-theme') === 'dark') t = 'dark'; } catch (e) {}
        h.dataset.theme = t === 'dark' ? 'dark' : 'light';
        if (m === 'off' || (!m && matchMedia('(prefers-reduced-motion: reduce)').matches)) h.dataset.motion = 'off'; else h.dataset.motion = 'on';
        document.documentElement.style.backgroundColor = t === 'dark' ? '#06070a' : '#faf7f0';
        document.documentElement.classList.add('js');
      })();
    </script>
    <noscript><style>.rv{opacity:1!important;transform:none!important}</style></noscript>
    <canvas id="lattice" aria-hidden="true"></canvas>
    <PodSymbols />

    <header class="hnav">
      <div class="wrap hnav-in">
        <a class="brand" href="/" aria-label="Back to American Car Saga"><span class="b-arrow">←</span><span class="b-name">ACS<i>//</i>GARAGE GEAR</span></a>
        <nav class="hlinks" aria-label="Garage Gear sections">
          <a href="#studio">Design</a><a href="#collection">Collection</a><a href="#anatomy">Anatomy</a><a href="#faq">FAQ</a>
        </nav>
        <div class="hnav-r">
          <a class="obtn small" href="#studio">Order <span>↗</span></a>
        </div>
      </div>
    </header>

    <div class="toolbar-wrap">
      <div class="wrap toolbar" role="group" aria-label="Display settings">
        <div class="grp"><span class="tl">Display</span>
          <button type="button" class="seg" data-theme-set="light" aria-pressed="true">Light</button>
          <button type="button" class="seg" data-theme-set="dark" aria-pressed="false">Dark</button></div>
        <div class="grp"><span class="tl">Motion</span>
          <button type="button" class="seg" data-motion-set="on" aria-pressed="true">On</button>
          <button type="button" class="seg" data-motion-set="off" aria-pressed="false">Off</button></div>
        <div class="grp"><span class="tl">Text</span>
          <button type="button" class="seg" data-size="" aria-label="Normal text">A</button>
          <button type="button" class="seg" data-size="lg" aria-label="Larger text">A+</button>
          <button type="button" class="seg" data-size="xl" aria-label="Largest text">A++</button></div>
      </div>
    </div>

    <section class="hero" id="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow rv">[ SERIES 01 ] &nbsp;PRINT ON DEMAND</p>
          <h1 data-scramble>GARAGE GEAR.</h1>
          <p class="lead rv" style="--d:.15s">Original American car art, drawn for the people who still check the oil. Try every design on every product, add your own line, and order. Each piece is printed only after you do.</p>
          <div class="cta rv" style="--d:.3s">
            <a class="obtn solid" href="#studio">Design yours <span>→</span></a>
            <a class="obtn" href="#collection">View collection</a>
          </div>
          <dl class="stats rv" style="--d:.45s">
            <div><dt>Designs</dt><dd data-count={POD_DESIGNS.length}>{String(POD_DESIGNS.length).padStart(2, '0')}</dd></div>
            <div><dt>Products</dt><dd data-count={POD_PRODUCTS.length}>{String(POD_PRODUCTS.length).padStart(2, '0')}</dd></div>
            <div><dt>Colours</dt><dd data-count={POD_COLORS.length}>{String(POD_COLORS.length).padStart(2, '0')}</dd></div>
          </dl>
        </div>

        <figure class="plate rv" id="plate" style="--d:.2s">
          <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
          <div class="ring" aria-hidden="true"></div>
          <div class="orbit" aria-hidden="true"></div>
          <div class="float">
            <svg viewBox="0 0 400 400" role="img" aria-label="Hoodie with the V8 Tachometer design, shown with a shifting iridescent finish">
              <defs>
                <linearGradient id="irid" gradientUnits="userSpaceOnUse" x1="30" y1="40" x2="370" y2="360">
                  <stop offset="0" stop-color="#0f1b4d" /><stop offset=".25" stop-color="#4b2fd6" /><stop offset=".5" stop-color="#c13fc8" /><stop offset=".72" stop-color="#2fb7ff" /><stop offset="1" stop-color="#0f1b4d" />
                  <animateTransform attributeName="gradientTransform" type="translate" values="-90 -60;90 60;-90 -60" dur="9s" repeatCount="indefinite" />
                </linearGradient>
                <linearGradient id="gloss" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".38" /><stop offset=".28" stop-color="#fff" stop-opacity="0" /><stop offset=".7" stop-color="#000" stop-opacity=".28" /><stop offset="1" stop-color="#000" stop-opacity=".5" /></linearGradient>
              </defs>
              <path d="M135 72 L90 88 L35 205 L72 220 L105 168 L105 352 L295 352 L295 168 L328 220 L365 205 L310 88 L265 72 Q200 36 135 72 Z" fill="url(#irid)" stroke="var(--rim)" stroke-opacity=".55" stroke-width="1.5" stroke-linejoin="round" />
              <path d="M150 74 Q200 8 250 74 Q200 118 150 74 Z" fill="#000" opacity=".3" />
              <path d="M180 100 V150 M220 100 V150" stroke="#dfe8ff" stroke-opacity=".7" stroke-width="3" stroke-linecap="round" />
              <path d="M150 290 L250 290 L272 336 L128 336 Z" fill="#000" opacity=".22" />
              <path d="M135 72 L90 88 L35 205 L72 220 L105 168 L105 352 L295 352 L295 168 L328 220 L365 205 L310 88 L265 72 Q200 36 135 72 Z" fill="url(#gloss)" />
              <g style="--ink:#eaf0ff;--ink2:#ff7ab0"><use href="#d-gauge" x="140" y="150" width="120" height="120" /></g>
            </svg>
          </div>
          <figcaption class="plate-cap"><span>FIG.01 — HOODIE / V8 TACHOMETER</span><span class="rpm">RPM <b id="rpm">7200</b></span></figcaption>
        </figure>
      </div>
      <a class="scroll-cue rv" href="#studio" style="--d:.7s" aria-label="Scroll to the design studio"><span>SCROLL</span><i></i></a>
    </section>

    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        {[0, 1].map(() => <div class="ticker-set">{ticker.map((t) => <span>{t}<b>◆</b></span>)}</div>)}
      </div>
    </div>

    <section class="sec" id="studio" aria-labelledby="studio-h">
      <div class="wrap">
        <header class="sec-head">
          <p class="eyebrow rv">[ 01 ] &nbsp;STUDIO</p>
          <h2 id="studio-h" data-scramble>DESIGN YOURS.</h2>
          <p class="sub rv">Pick a design, a product and a colour. The preview updates instantly.</p>
        </header>

        <div class="studio-grid">
          <div class="stage rv" id="stage" data-product="tee" style={`--g:${POD_COLORS[0].hex};--ink:#1d1d20;--ink2:#9b2c2c`}>
            <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
            <span class="tag tl-t">FIG.02</span><span class="tag tr-t">SCALE 1:1</span>
            <svg id="mock" viewBox="0 0 400 400" role="img" aria-label="Product preview">
              <defs>
                <linearGradient id="cyl" x1="0" x2="1"><stop offset="0" stop-color="#000" stop-opacity=".3" /><stop offset=".3" stop-color="#fff" stop-opacity=".2" /><stop offset=".55" stop-color="#000" stop-opacity="0" /><stop offset="1" stop-color="#000" stop-opacity=".34" /></linearGradient>
                <linearGradient id="fold" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".16" /><stop offset="1" stop-color="#000" stop-opacity=".22" /></linearGradient>
              </defs>
              <ellipse cx="200" cy="372" rx="130" ry="9" fill="#7ea4ff" opacity=".16" />

              <g data-p="tee">
                <path d="M140 60 L100 75 L40 125 L75 165 L105 145 L105 340 L295 340 L295 145 L325 165 L360 125 L300 75 L260 60 Q200 102 140 60 Z" fill="var(--g)" stroke="var(--rim)" stroke-opacity=".5" stroke-width="1.5" stroke-linejoin="round" />
                <path d="M140 60 Q200 102 260 60 Q200 82 140 60 Z" fill="#000" opacity=".25" />
                <path d="M140 60 L100 75 L40 125 L75 165 L105 145 L105 340 L295 340 L295 145 L325 165 L360 125 L300 75 L260 60 Q200 102 140 60 Z" fill="url(#fold)" />
                <use class="art" href={`#d-${first.id}`} x="138" y="112" width="124" height="124" />
                <text class="custom" x="200" y="252" text-anchor="middle" font-family="ui-monospace, Menlo, Consolas, monospace" font-weight="700" font-size="10" letter-spacing="1.5" fill="var(--ink)"></text>
              </g>

              <g data-p="hoodie" style="display:none">
                <path d="M135 72 L90 88 L35 205 L72 220 L105 168 L105 352 L295 352 L295 168 L328 220 L365 205 L310 88 L265 72 Q200 36 135 72 Z" fill="var(--g)" stroke="var(--rim)" stroke-opacity=".5" stroke-width="1.5" stroke-linejoin="round" />
                <path d="M150 74 Q200 8 250 74 Q200 118 150 74 Z" fill="#000" opacity=".22" />
                <path d="M180 100 V150 M220 100 V150" stroke="var(--ink)" stroke-opacity=".6" stroke-width="3" stroke-linecap="round" />
                <path d="M150 290 L250 290 L272 336 L128 336 Z" fill="#000" opacity=".14" />
                <path d="M135 72 L90 88 L35 205 L72 220 L105 168 L105 352 L295 352 L295 168 L328 220 L365 205 L310 88 L265 72 Q200 36 135 72 Z" fill="url(#fold)" />
                <use class="art" href={`#d-${first.id}`} x="144" y="152" width="112" height="112" />
                <text class="custom" x="200" y="278" text-anchor="middle" font-family="ui-monospace, Menlo, Consolas, monospace" font-weight="700" font-size="9" letter-spacing="1.5" fill="var(--ink)"></text>
              </g>

              <g data-p="mug" style="display:none">
                <path d="M280 150 Q352 150 352 206 Q352 262 280 262" fill="none" stroke="var(--g)" stroke-width="20" />
                <path d="M280 150 Q352 150 352 206 Q352 262 280 262" fill="none" stroke="var(--rim)" stroke-opacity=".5" stroke-width="1.5" />
                <rect x="108" y="104" width="176" height="200" rx="14" fill="var(--g)" stroke="var(--rim)" stroke-opacity=".5" stroke-width="1.5" />
                <rect x="108" y="104" width="176" height="200" rx="14" fill="url(#cyl)" />
                <ellipse cx="196" cy="104" rx="88" ry="12" fill="#000" opacity=".3" />
                <ellipse cx="196" cy="104" rx="88" ry="12" fill="none" stroke="var(--rim)" stroke-opacity=".4" />
                <use class="art" href={`#d-${first.id}`} x="136" y="140" width="120" height="120" />
                <text class="custom" x="196" y="278" text-anchor="middle" font-family="ui-monospace, Menlo, Consolas, monospace" font-weight="700" font-size="9" letter-spacing="1.5" fill="var(--ink)"></text>
              </g>

              <g data-p="poster" style="display:none">
                <rect x="84" y="34" width="232" height="326" fill="#14161d" stroke="var(--rim)" stroke-opacity=".5" stroke-width="1.5" />
                <rect x="100" y="50" width="200" height="294" fill="var(--g)" />
                <rect x="100" y="50" width="200" height="294" fill="url(#fold)" opacity=".5" />
                <use class="art" href={`#d-${first.id}`} x="112" y="92" width="176" height="176" />
                <text class="custom" x="200" y="302" text-anchor="middle" font-family="ui-monospace, Menlo, Consolas, monospace" font-weight="700" font-size="12" letter-spacing="2" fill="var(--ink)"></text>
                <text x="200" y="326" text-anchor="middle" font-family="ui-monospace, Menlo, Consolas, monospace" font-size="7" letter-spacing="3" fill="var(--ink)" opacity=".7">AMERICAN CAR SAGA</text>
              </g>
            </svg>
            <p class="stage-caption" id="caption" aria-live="polite">{first.name} · T-Shirt · {POD_COLORS[0].name}</p>
          </div>

          <form class="controls" onsubmit="return false" aria-label="Customize your product">
            <fieldset class="rv">
              <legend><b>01</b> Design</legend>
              <div class="designs">
                {POD_DESIGNS.map((d, i) => (
                  <label class="design" style={`--a-d:${accents[i % accents.length]};--a-l:${accentsLight[i % accentsLight.length]}`}>
                    <input type="radio" name="design" value={d.id} checked={i === 0} />
                    <span class="thumb"><svg viewBox="0 0 200 200" aria-hidden="true"><use href={`#d-${d.id}`} width="200" height="200" /></svg></span>
                    <span class="d-name">{d.name}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <fieldset class="rv">
              <legend><b>02</b> Product</legend>
              <div class="pills">
                {POD_PRODUCTS.map((p, i) => (
                  <label class="pill"><input type="radio" name="product" value={p.id} checked={i === 0} /><span><strong>{p.name}</strong><small>{p.note}</small></span></label>
                ))}
              </div>
            </fieldset>

            <fieldset class="rv">
              <legend><b>03</b> Colour</legend>
              <div class="swatches">
                {POD_COLORS.map((c, i) => (
                  <label class="swatch" title={c.name}><input type="radio" name="color" value={c.id} checked={i === 0} /><span style={`background:${c.hex}`}></span><em>{c.name}</em></label>
                ))}
              </div>
            </fieldset>

            <div class="personal rv">
              <label for="custom"><b>04</b> Your line <small>(optional)</small></label>
              <input id="custom" name="custom" type="text" maxlength="26" placeholder="E.G. DAVE’S 1969 CAMARO" autocomplete="off" />
              <p class="hint">A name, a year or your car. It sits under the artwork. Personalised items need the personalisation option enabled in the store.</p>
            </div>

            <div class="buy rv">
              <a id="buy" class="obtn solid big" href="#" rel="noopener" target="_blank" data-pod="buy">Order this design <span>→</span></a>
              <p class="ship">{SITE.pod.shippingNote}</p>
              {!SITE.pod.storeUrl && <p class="ship soon">[ STORE OPENS SOON ] The button sends us a message so we can notify you.</p>}
            </div>
          </form>
        </div>
      </div>
    </section>

    <section class="sec" id="collection" aria-labelledby="coll-h">
      <div class="wrap">
        <header class="sec-head row">
          <div>
            <p class="eyebrow rv">[ 02 ] &nbsp;COLLECTION</p>
            <h2 id="coll-h" data-scramble>THE DROP.</h2>
          </div>
          <p class="sub rv">{POD_DESIGNS.length} original designs. Tap one to try it on a product.</p>
        </header>
        <div class="cards">
          {POD_DESIGNS.map((d, i) => (
            <article class="card rv" style={`--a-d:${accents[i % accents.length]};--a-l:${accentsLight[i % accentsLight.length]};--d:${(i % 3) * 0.1}s`}>
              <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <div class="card-art">
                <svg viewBox="0 0 200 200" aria-hidden="true"><use href={`#d-${d.id}`} width="200" height="200" /></svg>
                <span class="scan" aria-hidden="true"></span>
              </div>
              <h3>{d.name}</h3>
              <p>{d.tagline}</p>
              <button type="button" class="obtn try" data-design={d.id}>Try it on <span>↑</span></button>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="sec anat" id="anatomy" aria-labelledby="anat-h">
      <div class="wrap anat-grid">
        <div class="anat-copy">
          <p class="eyebrow rv">[ 03 ] &nbsp;ANATOMY</p>
          <h2 id="anat-h" data-scramble>ANATOMY OF A PRINT.</h2>
          <p class="sub rv">Scroll and the layers come apart. Every piece is built from the same four parts.</p>
          <ol class="alist" id="alist">
            <li data-k="3"><b>01</b><div><strong>The artwork</strong><span>Vector art drawn for American Car Saga, so it prints sharp at any size.</span></div></li>
            <li data-k="2"><b>02</b><div><strong>The print</strong><span>Your design is printed on demand, only after you order.</span></div></li>
            <li data-k="1"><b>03</b><div><strong>Your line</strong><span>An optional name, year or car, placed under the artwork.</span></div></li>
            <li data-k="0"><b>04</b><div><strong>The product</strong><span>The shirt, hoodie, mug or poster itself, made by our print partner.</span></div></li>
          </ol>
        </div>
        <div class="exp rv" id="exp" aria-hidden="true">
          <div class="stack">
            <div class="layer l0"><span class="weave"></span><em>PRODUCT</em></div>
            <div class="layer l1"><span class="yourline">YOUR LINE HERE</span><em>LINE</em></div>
            <div class="layer l2"><span class="dots"></span><em>PRINT</em></div>
            <div class="layer l3"><svg viewBox="0 0 200 200"><use href="#d-route66" width="200" height="200" /></svg><em>ARTWORK</em></div>
          </div>
        </div>
      </div>
    </section>

    <section class="sec specs" aria-label="Why Garage Gear">
      <div class="wrap">
        <div class="spec-grid">
          <article class="spec rv"><b>01</b><h3>Made to order</h3><p>Printed only after you order. Nothing sits in a warehouse.</p></article>
          <article class="spec rv" style="--d:.1s"><b>02</b><h3>Your line</h3><p>Add a name, a year or a car. We place it under the art.</p></article>
          <article class="spec rv" style="--d:.2s"><b>03</b><h3>Ships from our partner</h3><p>Production, delivery and tracking come from the print partner.</p></article>
          <article class="spec rv" style="--d:.3s"><b>04</b><h3>Original art</h3><p>Drawn for American Car Saga. No manufacturer logos.</p></article>
        </div>
      </div>
    </section>

    <section class="sec" id="faq" aria-labelledby="faq-h">
      <div class="wrap narrow">
        <header class="sec-head">
          <p class="eyebrow rv">[ 04 ] &nbsp;FAQ</p>
          <h2 id="faq-h" data-scramble>QUESTIONS.</h2>
        </header>
        <details class="rv"><summary>Where do I pay?</summary><p>Checkout happens securely on our store partner’s site, not on American Car Saga, so we never see your card details.</p></details>
        <details class="rv"><summary>How long does delivery take?</summary><p>Items are made to order, so production plus shipping usually takes about one to two weeks. The exact estimate is shown at checkout.</p></details>
        <details class="rv"><summary>Can I return an item?</summary><p>If an item arrives damaged or misprinted we will replace it. Because everything is made just for you, other returns are limited. Full details are on the store’s policy page.</p></details>
        <details class="rv"><summary>Does the preview match the real product?</summary><p>The preview is an illustration. Real fabric, ink and colours can look slightly different on screen and in person.</p></details>
      </div>
    </section>

    <footer class="hfoot">
      <div class="wrap hfoot-in">
        <a class="brand" href="/"><span class="b-arrow">←</span><span class="b-name">AMERICAN CAR SAGA</span></a>
        <nav aria-label="Legal"><a href="/privacy-policy">Privacy</a><a href="/terms">Terms</a><a href="/affiliate-disclosure">Disclosure</a><a href="/contact">Contact</a></nav>
        <p>© {new Date().getFullYear()} {SITE.name}. Garage Gear items are made to order and fulfilled by our print partner.</p>
      </div>
    </footer>
  </div>
</BaseLayout>

<script is:inline define:vars={{ cfg }}>
  (function () {
    var hud = document.getElementById('top');
    function calm() { return hud.dataset.motion === 'off'; }
    function isDark() { return hud.dataset.theme === 'dark'; }

    /* ---------- Lit lattice: squares light up under the pointer ---------- */
    var cv = document.getElementById('lattice');
    if (cv) {
      var ctx = cv.getContext('2d'), CELL = 22, W, H, dpr, cells = new Map(), raf = 0, last = 0;
      var size = function () {
        dpr = Math.min(devicePixelRatio || 1, 2); W = innerWidth; H = innerHeight;
        cv.width = W * dpr; cv.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };
      size(); addEventListener('resize', size);
      var frame = function (t) {
        raf = 0; var dt = Math.min(50, t - last); last = t;
        ctx.clearRect(0, 0, W, H);
        cells.forEach(function (c, k) {
          c.a -= dt * 0.0011;
          if (c.a <= 0) { cells.delete(k); return; }
          ctx.fillStyle = isDark() ? 'hsla(' + c.h + ',90%,68%,' + (c.a * 0.5).toFixed(3) + ')' : 'hsla(' + c.h + ',62%,38%,' + (c.a * 0.24).toFixed(3) + ')';
          ctx.fillRect(c.x * CELL + 1, c.y * CELL + 1, CELL - 1, CELL - 1);
        });
        if (cells.size) raf = requestAnimationFrame(frame);
      };
      var HUES = [212, 352, 38];
      var light = function (px, py, r, str) {
        if (calm()) return;
        var hue = HUES[(Math.random() * 3) | 0];
        var cx = Math.floor(px / CELL), cy = Math.floor(py / CELL), n = Math.ceil(r / CELL);
        for (var i = -n; i <= n; i++) for (var j = -n; j <= n; j++) {
          var d = Math.sqrt(i * i + j * j); if (d > n) continue;
          if (Math.random() > 0.8 * (1 - d / (n + 1)) + 0.15) continue;
          var a = str * (1 - d / (n + 1)) * (0.5 + Math.random() * 0.5), k = (cx + i) + ',' + (cy + j), c = cells.get(k);
          if (!c || c.a < a) cells.set(k, { x: cx + i, y: cy + j, a: a, h: isDark() ? (px * 0.22 + py * 0.12 + performance.now() / 30) % 360 : hue });
        }
        if (!raf) { last = performance.now(); raf = requestAnimationFrame(frame); }
      };
      addEventListener('pointermove', function (e) { light(e.clientX, e.clientY, 66, 1); }, { passive: true });
      addEventListener('pointerdown', function (e) { light(e.clientX, e.clientY, 130, 1.3); }, { passive: true });
      var lastY = scrollY;
      addEventListener('scroll', function () {
        if (Math.abs(scrollY - lastY) < 40) return; lastY = scrollY;
        light(Math.random() * W, H * (0.25 + Math.random() * 0.5), 80, 0.7);
      }, { passive: true });
      setInterval(function () { if (!document.hidden && !calm()) light(Math.random() * W, Math.random() * H, 90, 0.55); }, 2400);
    }

    /* ---------- Text scramble on headings ---------- */
    var G = 'ABCDEFGHJKLMNOPQRSTUVWXYZ0123456789#/<>_-+=';
    function scramble(el) {
      var txt = el.dataset.text || el.textContent; el.dataset.text = txt; el.setAttribute('aria-label', txt);
      if (calm()) return;
      var n = txt.length, t0 = performance.now(), dur = 600 + n * 24;
      (function step(t) {
        var p = Math.min(1, (t - t0) / dur), out = '';
        for (var i = 0; i < n; i++) { var ch = txt.charAt(i); out += (ch === ' ' || ch === '.' || ch === '’' || i < p * n) ? ch : G.charAt((Math.random() * G.length) | 0); }
        el.textContent = out;
        if (p < 1) requestAnimationFrame(step);
        else { el.textContent = txt; el.classList.add('glitch'); setTimeout(function () { el.classList.remove('glitch'); }, 360); }
      })(t0);
    }

    /* ---------- Reveal on scroll, counters, scramble triggers ---------- */
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        var el = e.target; io.unobserve(el);
        if (el.classList.contains('rv')) el.classList.add('in');
        if (el.hasAttribute('data-scramble')) scramble(el);
        if (el.hasAttribute('data-count')) {
          var to = +el.dataset.count, t0 = performance.now();
          if (!calm()) (function tick(t) { var p = Math.min(1, (t - t0) / 900); el.textContent = String(Math.round(to * p)).padStart(2, '0'); if (p < 1) requestAnimationFrame(tick); })(t0);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -6% 0px' });
    document.querySelectorAll('.rv, [data-scramble], [data-count]').forEach(function (el) { io.observe(el); });

    /* ---------- Hero plate: pointer tilt + live RPM readout ---------- */
    var plate = document.getElementById('plate'), hero = document.getElementById('hero');
    if (plate && matchMedia('(hover: hover)').matches) {
      var tick = 0, rx = 0, ry = 0;
      hero.addEventListener('pointermove', function (e) {
        if (calm()) return;
        var r = hero.getBoundingClientRect();
        ry = ((e.clientX - r.left) / r.width - 0.5) * 18; rx = -((e.clientY - r.top) / r.height - 0.5) * 14;
        if (!tick) tick = requestAnimationFrame(function () { tick = 0; plate.style.setProperty('--rx', rx.toFixed(2) + 'deg'); plate.style.setProperty('--ry', ry.toFixed(2) + 'deg'); });
      });
      hero.addEventListener('pointerleave', function () { plate.style.setProperty('--rx', '0deg'); plate.style.setProperty('--ry', '0deg'); });
    }
    var rpm = document.getElementById('rpm');
    if (rpm) setInterval(function () { if (!document.hidden && !calm()) rpm.textContent = String(6800 + ((Math.random() * 700) | 0)); }, 180);

    /* ---------- Anatomy: layers separate as you scroll ---------- */
    var exp = document.getElementById('exp'), items = document.querySelectorAll('#alist li'), busy = 0;
    function spread() {
      busy = 0;
      var r = exp.getBoundingClientRect(), vh = innerHeight;
      var p = calm() ? 1 : Math.max(0, Math.min(1, (vh * 0.9 - r.top) / (vh * 0.55)));
      exp.style.setProperty('--sp', p.toFixed(3));
      items.forEach(function (li) { li.classList.toggle('on', p > 0.12 + (3 - +li.dataset.k) * 0.22); });
    }
    if (exp) { spread(); addEventListener('scroll', function () { if (!busy) busy = requestAnimationFrame(spread); }, { passive: true }); addEventListener('resize', spread); }

    /* ---------- Display settings: theme, motion, text size ---------- */
    var meta = document.querySelector('meta[name="theme-color"]');
    function sync() {
      document.querySelectorAll('[data-theme-set]').forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.themeSet === hud.dataset.theme)); });
      document.querySelectorAll('[data-motion-set]').forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.motionSet === hud.dataset.motion)); });
      var cur = document.documentElement.dataset.size || '';
      document.querySelectorAll('.toolbar [data-size]').forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.size === cur)); });
      var bg = isDark() ? '#06070a' : '#faf7f0';
      document.documentElement.style.backgroundColor = bg; if (meta) meta.setAttribute('content', bg);
    }
    document.querySelectorAll('[data-theme-set]').forEach(function (b) {
      b.addEventListener('click', function () {
        hud.dataset.theme = b.dataset.themeSet;
        try { localStorage.setItem('acs-pod-theme', b.dataset.themeSet); } catch (e) {}
        sync(); window.acsTrack && acsTrack('pod_setting', { setting: 'theme', value: b.dataset.themeSet });
      });
    });
    document.querySelectorAll('[data-motion-set]').forEach(function (b) {
      b.addEventListener('click', function () {
        hud.dataset.motion = b.dataset.motionSet;
        try { localStorage.setItem('acs-pod-motion', b.dataset.motionSet); } catch (e) {}
        sync(); spread && spread(); window.acsTrack && acsTrack('pod_setting', { setting: 'motion', value: b.dataset.motionSet });
      });
    });
    document.querySelectorAll('.toolbar [data-size]').forEach(function (b) {
      b.addEventListener('click', function () {
        var v = b.dataset.size, d = document.documentElement;
        if (v) d.dataset.size = v; else delete d.dataset.size;
        try { v ? localStorage.setItem('acs-size', v) : localStorage.removeItem('acs-size'); } catch (e) {}
        sync(); window.acsTrack && acsTrack('text_size_change', { size: v || 'normal' });
      });
    });
    sync();

    /* ---------- Studio ---------- */
    var stage = document.getElementById('stage'), mock = document.getElementById('mock');
    var cap = document.getElementById('caption'), buy = document.getElementById('buy');
    var form = document.querySelector('.controls');
    var state = { design: form.design.value, product: form.product.value, color: form.color.value, text: '' };
    function lum(hex) { var n = parseInt(hex.slice(1), 16); return (0.299 * (n >> 16) + 0.587 * ((n >> 8) & 255) + 0.114 * (n & 255)) / 255; }
    function render() {
      var c = cfg.colors[state.color], light = lum(c.hex) > 0.55;
      stage.style.setProperty('--g', c.hex);
      stage.style.setProperty('--ink', light ? '#1d1d20' : '#f4efe3');
      stage.style.setProperty('--ink2', light ? '#9b2c2c' : '#e3b866');
      mock.querySelectorAll('[data-p]').forEach(function (g) { g.style.display = g.dataset.p === state.product ? '' : 'none'; });
      mock.querySelectorAll('.art').forEach(function (u) { u.setAttribute('href', '#d-' + state.design); });
      mock.querySelectorAll('.custom').forEach(function (t) { t.textContent = state.text.toUpperCase(); });
      var d = cfg.designs[state.design];
      cap.textContent = d.name + ' · ' + cfg.products[state.product] + ' · ' + c.name + (state.text ? ' · “' + state.text + '”' : '');
      var base = d.url || cfg.storeUrl;
      if (base) {
        var u = new URL(base, location.href);
        u.searchParams.set('utm_source', 'americancarsaga'); u.searchParams.set('utm_medium', 'garage_gear'); u.searchParams.set('utm_campaign', state.design);
        if (state.text) u.searchParams.set('custom_text', state.text);
        buy.href = u.toString(); buy.target = '_blank'; buy.firstChild.nodeValue = 'Order this design ';
      } else {
        var body = 'Please notify me when Garage Gear opens.\n\nDesign: ' + d.name + '\nProduct: ' + cfg.products[state.product] + '\nColour: ' + c.name + (state.text ? '\nMy line: ' + state.text : '');
        buy.href = 'mailto:' + cfg.email + '?subject=' + encodeURIComponent('Garage Gear: notify me') + '&body=' + encodeURIComponent(body);
        buy.removeAttribute('target'); buy.firstChild.nodeValue = 'Notify me when it opens ';
      }
      buy.dataset.product = d.name + ' / ' + cfg.products[state.product];
    }
    form.addEventListener('change', function (e) {
      if (e.target.name in state) { state[e.target.name] = e.target.value; render(); stage.classList.remove('pulse'); void stage.offsetWidth; stage.classList.add('pulse');
        window.acsTrack && acsTrack('pod_select', { option: e.target.name, value: e.target.value }); }
    });
    form.custom.addEventListener('input', function () { state.text = form.custom.value.trim(); render(); });
    document.querySelectorAll('.try').forEach(function (b) {
      b.addEventListener('click', function () {
        form.design.value = b.dataset.design; state.design = b.dataset.design; render();
        document.getElementById('studio').scrollIntoView({ behavior: calm() ? 'auto' : 'smooth', block: 'start' });
        window.acsTrack && acsTrack('pod_select', { option: 'design', value: b.dataset.design, from: 'collection' });
      });
    });
    render();
  })();
</script>

<style>
  .hud {
    /* LIGHT (default) */
    --bg: #faf7f0; --line: rgba(29, 53, 87, .18); --line2: rgba(29, 53, 87, .42);
    --txt: #1e2227; --mut: #454c57; --acc: #1d4e89; --hot: #9b2c2c;
    --head: #14243d; --lead: #2f3640; --faint: #5b6370;
    --tint: rgba(29, 53, 87, .04); --hover: rgba(29, 53, 87, .07);
    --panel-a: rgba(255, 253, 248, .86); --panel-b: rgba(255, 253, 248, .92);
    --bg-a: rgba(250, 247, 240, .9); --bg-b: rgba(241, 235, 223, .96);
    --solid-bg: #1d3557; --solid-fg: #fdfaf3;
    --grid: rgba(29, 53, 87, .075);
